# VisaTrack — Variables d'environnement
# 1. Copiez ce fichier : cp .env.example .env
# 2. Remplissez les valeurs ci-dessous
# 3. Ne commitez JAMAIS le fichier .env sur Git

# ── Django ───────────────────────────────────
SECRET_KEY=django-insecure-remplacez-par-une-vraie-cle-secrete-longue
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# ── Base de données ──────────────────────────
# SQLite pour développement (par défaut) :
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL pour production :
# DATABASE_URL=postgres://visatrack:motdepasse@localhost:5432/visatrack

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email ────────────────────────────────────
# Pour développement : affiche les emails dans la console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Pour production (Gmail) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=VisaTrack <alertes@visatrack.app>

# ── Telegram Bot ─────────────────────────────
# Obtenez un token sur https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
TELEGRAM_WEBHOOK_URL=https://votre-domaine.com/api/bot/telegram/webhook/
TELEGRAM_WEBHOOK_SECRET=un-secret-aleatoire-de-32-caracteres

# ── WhatsApp Business API ────────────────────
# Depuis https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=EAAGm...
WHATSAPP_PHONE_ID=1234567890

# ── Stripe ───────────────────────────────────
# Depuis https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_xxx
STRIPE_PRICE_VIP=price_yyy

# ── CORS (pour le frontend Next.js) ──────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
